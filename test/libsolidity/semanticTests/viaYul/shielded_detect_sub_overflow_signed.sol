// Adapted from: test/libsolidity/semanticTests/viaYul/detect_sub_overflow_signed.sol
contract C {
    function f(sint256 a, sint256 b) public pure returns (int256 x) {
        x = int256(a - b);
    }
    function g(sint8 a, sint8 b) public pure returns (int8 x) {
        x = int8(a - b);
    }
}
